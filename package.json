{
  "name": "playwright-demo",
  "version": "1.0.0",
  "description": "Playwright + TypeScript demo: UI tests with Page Object Model and API tests, running in GitHub Actions.",
  "author": "Helena Leal",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=mobile",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "zod": "^4.6.7"
  }
}
